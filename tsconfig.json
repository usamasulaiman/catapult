{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/*/src", "apps/orchestrator/src", "workers/*/src", "packages/**/*.test.ts", "apps/orchestrator/**/*.test.ts", "workers/**/*.test.ts"],
  "exclude": ["node_modules"]
}
